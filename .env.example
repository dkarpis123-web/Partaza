# Nukopijuokite šį failą pavadinimu ".env" ir įrašykite dvi reikšmes iš "Supabase" projekto
# (Project Settings -> API). Abi reikšmės yra viešos – jos skirtos programėlei.
# SLAPTO rakto (secret / service_role) čia NIEKADA nerašykite.
# Kol reikšmės tuščios, programėlė veikia bandomuoju režimu su pavyzdiniais skelbimais.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
